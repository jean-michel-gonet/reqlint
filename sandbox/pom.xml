<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.reqlint</groupId>
        <artifactId>reqlint</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>reqlint-sandbox</artifactId>
    <packaging>jar</packaging>
    <description>A small project to showcase REQLINT.
        It contains the requirements and implementation for a Token Bucket service.
        The service is tested via cucumber.
        It uses reqlint-maven-plugin to validate the documentation and produce the traceability matrix plus the test report.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>com.reqlint</groupId>
                <artifactId>reqlint-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <!-- The traceability matrix -->
                    <execution>
                        <id>traceability-matrix-config</id>
                        <phase>none</phase>
                        <goals>
                            <goal>traceability-matrix</goal>
                        </goals>
                        <configuration>
                            <inputFilePath>classes/documentation/root.tex</inputFilePath>
                            <traceabilityMatrixFilePath>classes/documentation/traceability/traceability-matrix.tex</traceabilityMatrixFilePath>
                            <traceabilityWarningsFilePath>classes/documentation/traceability/traceability-warnings.tex</traceabilityWarningsFilePath>
                        </configuration>
                    </execution>

                    <!-- The test results -->
                    <execution>
                        <id>test-results-config</id>
                        <phase>none</phase>
                        <goals>
                            <goal>test-results</goal>
                        </goals>
                        <configuration>
                            <inputFilePath>classes/documentation/root.tex</inputFilePath>
                            <surefireReportsFolderPath>surefire-reports</surefireReportsFolderPath>
                            <testResultsFilePath>classes/documentation/testresults/testresults-report.tex</testResultsFilePath>
                            <testWarningsFilePath>classes/documentation/testresults/testresults-warning.tex</testWarningsFilePath>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>