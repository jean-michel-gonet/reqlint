\NeedsTeXFormat{LaTeX2e}

% --- Required Packages ---
\RequirePackage{import}
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage{graphicx} % For diagrams/images if needed
\RequirePackage{booktabs} % For beautiful tables
\RequirePackage{nameref} % To display the label values, handy when referring to ER, SR and TC.
\RequirePackage{etoolbox}
\RequirePackage{xcolor}
\RequirePackage{amsopn}
\RequirePackage{enumitem}

% --- Error Handling for Empty Fields ---
\newcommand{\CheckNotEmpty}[2]{%
  \ifblank{#1}{%
    \PackageError{template}{The ID field cannot be empty}{Please provide a valid identifier.}%
  }{}%
  \ifblank{#2}{%
    \PackageError{template}{The description for ID '#1' cannot be empty}{Please provide a short descriptive title.}%
  }{}%
}

% --- Custom Command Definitions ---
% 1. Equipment Requirement (ER)
\newenvironment{equipmentrequirement}[2]{
    \CheckNotEmpty{#1}{#2}%
    \subsubsection{\textcolor{blue!75!black}{#1:} #2}%
    \label{#1}
}{}

% 2. Software Requirement (SR)
\newenvironment{softwarerequirement}[2]{
    \CheckNotEmpty{#1}{#2}
    \subsubsection{\textcolor{green!60!black}{#1:} #2}
    \label{#1}
}{}

% 3. Test Case (TC)
\newenvironment{testcase}[2]{
  \CheckNotEmpty{#1}{#2}
  \subsubsection{\textcolor{orange!75!black}{#1:} #2}
  \label{#1}
}{}

% Links between elements
\newcommand{\childof}[1]{%
  \nameref{#1} - page~\pageref{#1}
}

% Define the testprocedure environment mapping \stage to \item
\newlist{testprocedure}{enumerate}{1}
\setlist[testprocedure]{%
    label=\textbf{Stage \arabic*}:, % Format: Stage 1:, Stage 2:
    ref=Stage \arabic*,            % How it looks if you \ref{} it
    leftmargin=*,                  % Clean indentation align
    before=\let\stage\item         % The magic: map \stage to \item locally
}